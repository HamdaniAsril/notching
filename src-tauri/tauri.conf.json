{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notching",
  "version": "0.1.1",
  "identifier": "id.web.notching",
  "build": {
    "beforeDevCommand": "npm run build:modules && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' notchmod: notchshot: data:; font-src 'self'; frame-src notchmod:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "../dist-modules/": "modules/",
      "media/np.pl": "media/np.pl",
      "media/build/libnotching-media.dylib": "media/libnotching-media.dylib"
    }
  }
}
